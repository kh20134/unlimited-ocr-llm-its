# Hugging Face 토큰. baidu/Unlimited-OCR 은 공개 모델이라 비워 두어도 됩니다.
# 다운로드 횟수 제한에 걸리면 https://huggingface.co/settings/tokens 에서 발급한 값을 넣으세요.
HF_TOKEN=

# OpenAI 호환 Chat Completions. 베이스 주소는 /v1 까지 포함합니다.
# OpenAI, vLLM, LM Studio 모두 같은 변수로 연결합니다.
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama. OpenAI 키가 없고 이 주소가 응답하면 auto 모드가 Ollama를 고릅니다.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# OCR: auto(기본) | fixture | local
# auto는 CUDA가 있으면 local, 없으면 fixture 입니다.
OCR_BACKEND=auto

# LLM: auto(기본) | openai | ollama | offline
# auto는 API 키, Ollama, 오프라인 데모 순서로 고릅니다.
LLM_BACKEND=auto

# 로컬 OCR 모델 ID. 기본값은 업스트림 공개 가중치입니다.
OCR_MODEL=baidu/Unlimited-OCR
